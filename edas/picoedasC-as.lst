    2108/C935 :                         ;---------------------------------------
    2109/C935 :                         ; Assembleroptionen setzen/rücksetzen
    2110/C935 :                         ; O x - Setze Assembler-Option mit Maske (1 Byte).
    2111/C935 :                         ; Bit 0 +01 - Unterdrücke Assemblerlisting; fehlerhafte Zeilen werden trotzdem
    2112/C935 :                         ; ausgegeben.
    2113/C935 :                         ; Bit 1 +02 - Maschinenkode in Speicher laden; nur wenn dieses Bit gesetzt ist,
    2114/C935 :                         ; wird der Maschinenkode im zugehörenden Speicher abgelegt.
    2115/C935 :                         ; Bit 2 +04 - Assemblerlisting zur Druckerschnittstelle; das Assemblerlisting wird
    2116/C935 :                         ; zeichenweise der Druckerschnittstelle übergeben.
    2117/C935 :                         ; Bit 4 + 10 - Erzwinge 2. Lauf bei Fehlern im 1. Lauf; im Normalfall wird bei
    2118/C935 :                         ; Fehlern im Lauf 1 an dessen Ende der Assembler abgebrochen.
    2119/C935 :                         ; Bit 5 +20 - Relative Sprungdistanzen sind absolut angegeben; hiermit kann z.B.
    2120/C935 :                         ; der Sprungangabe bei SYPS K 1520 entsprochen werden (z.B. JR marke-$).
    2121/C935 :                         ; Bit 7 + 80 - Ausgabe einer Symboltabelle; im Anschluß an den zweiten
    2122/C935 :                         ; Assemblerlauf wird eine alphabetisch geordnete Liste aller verwendeten Symbole
    2123/C935 :                         ; erzeugt, die auch deren Werte und die Zeilen, in denen sie definiert wurden,
    2124/C935 :                         ; enthält.
    2125/C935 :                         
    2126/C935 : 7D                      OPTIONS:	ld	a, l
    2127/C936 :                         loc_4938:	;;and	0B7h
    2128/C936 : E6 F7                   		and	0F7h
    2129/C938 : FD 77 01                		ld	(iy+1),	a	; Assembleroptionen
    2130/C93B : 32 07 FE                		ld	(byte_5507), a	; Assembleroptionen
