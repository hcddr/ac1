    4003/D3C8 : 2A BA FD                		ld	hl, (word_54BA)	; Adresse Ende Sekundärquelle (SEC)
    4004/D3CB : ED 5B 02 FE             		ld	de, (BUFEND)
    4005/D3CF : 22 02 FE                		ld	(BUFEND),	hl
    4006/D3D2 : ED 53 BA FD             		ld	(word_54BA), de	; Adresse Ende Sekundärquelle (SEC)
