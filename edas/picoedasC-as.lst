    3967/D3A2 :                         ; Vor dieser Vereinbarung muß sich ab aaaa bereits eine Quelle oder mindestens ein
    3968/D3A2 :                         ; Quellkopf befinden. Hinter SEC: erscheint aa, die Anfangsadresse des
    3969/D3A2 :                         ; Zweitquellenpuffers. Man muß darauf achten, daß sich der Zweitquellenpuffer
    3970/D3A2 :                         ; nicht mit dem aktuellen Quellpuffer oder mit EDAS*4 selbst überschneidet.
    3971/D3A2 :                         ; Hierbei darf eeee auch größer sein als das Ende einer von Kassette eingelesenen
    3972/D3A2 :                         ; Zweitquelle, will man diese dann noch erweitern, so ist es auch erforderlich.
    3973/D3A2 :                         ;
    3974/D3A2 :                         
    3975/D3A2 : FE 02                   SEC:		cp	2
    3976/D3A4 : C2 21 CB                		jp	nz, loc_4B2E
    3977/D3A7 : ED 5B 5D 18             		ld	de, (ARG2)		; eeee
    3978/D3AB : AF                      		xor	a			; Cy=0; A=0
    3979/D3AC : ED 52                   		sbc	hl, de
    3980/D3AE : 19                      		add	hl, de
    3981/D3AF : D2 23 CB                		jp	nc, loc_4B30		; Fehler ausgeben
    3982/D3B2 :                         						; Error 00 - Speicherüberlauf
    3983/D3B2 : 22 B8 FD                		ld	(word_54B8), hl		; Adresse Anfang Sekundärquelle (SEC)
    3984/D3B5 : ED 53 BA FD             		ld	(word_54BA), de		; Adresse Ende Sekundärquelle (SEC)
    3985/D3B9 : C9                      		ret
