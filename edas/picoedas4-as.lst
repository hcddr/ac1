    2101/4935 :                         ;---------------------------------------
    2102/4935 :                         ; Assembleroptionen setzen/rücksetzen
    2103/4935 :                         ; O x - Setze Assembler-Option mit Maske (1 Byte).
    2104/4935 :                         ; Bit 0 +01 - Unterdrücke Assemblerlisting; fehlerhafte Zeilen werden trotzdem
    2105/4935 :                         ; ausgegeben.
    2106/4935 :                         ; Bit 1 +02 - Maschinenkode in Speicher laden; nur wenn dieses Bit gesetzt ist,
    2107/4935 :                         ; wird der Maschinenkode im zugehörenden Speicher abgelegt.
    2108/4935 :                         ; Bit 2 +04 - Assemblerlisting zur Druckerschnittstelle; das Assemblerlisting wird
    2109/4935 :                         ; zeichenweise der Druckerschnittstelle übergeben.
    2110/4935 :                         ; Bit 4 + 10 - Erzwinge 2. Lauf bei Fehlern im 1. Lauf; im Normalfall wird bei
    2111/4935 :                         ; Fehlern im Lauf 1 an dessen Ende der Assembler abgebrochen.
    2112/4935 :                         ; Bit 5 +20 - Relative Sprungdistanzen sind absolut angegeben; hiermit kann z.B.
    2113/4935 :                         ; der Sprungangabe bei SYPS K 1520 entsprochen werden (z.B. JR marke-$).
    2114/4935 :                         ; Bit 7 + 80 - Ausgabe einer Symboltabelle; im Anschluß an den zweiten
    2115/4935 :                         ; Assemblerlauf wird eine alphabetisch geordnete Liste aller verwendeten Symbole
    2116/4935 :                         ; erzeugt, die auch deren Werte und die Zeilen, in denen sie definiert wurden,
    2117/4935 :                         ; enthält.
    2118/4935 :                         
    2119/4935 : 7D                      OPTIONS:	ld	a, l
    2120/4936 :                         loc_4938:	;;and	0B7h
    2121/4936 : E6 F7                   		and	0F7h
    2122/4938 : FD 77 01                		ld	(iy+1),	a	; Assembleroptionen
    2123/493B : 32 07 FE                		ld	(byte_5507), a	; Assembleroptionen
