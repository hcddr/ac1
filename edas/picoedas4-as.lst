    3533/5135 :                         
    3534/5135 :                         ;---------------------------------------
    3535/5135 :                         ; Q - Rücksprung zum Monitor.
    3536/5135 :                         ; Dieses Kommando übergibt die Steuerung wieder dem "AC1"-Monitor, zuvor wurden
    3537/5135 :                         ; die Argumentzeilen Arg1 bis Arg3 so geladen, daß der Quelltext einfach mit S:
    3538/5135 :                         ; name abgespeichert werden kann. EDAS*4 ist nun jederzeit wieder über einen
    3539/5135 :                         ; Warmstart zu aktivieren. Alle vor dem Verlassen eingestellten Parameter bleiben
    3540/5135 :                         ; erhalten, natürlich vorausgesetzt, es wurde nichts durch eine
    3541/5135 :                         ; Speichermanipulation zerstört. Soweit das EDAS*4 selbst betrifft, merkt er das
    3542/5135 :                         ; durch seine Prüfsumme und kehrt sofort zum Monitor zurück. Dann muß man EDAS*4
    3543/5135 :                         ; neu von der Kassette laden. Wenn man Glück hat und der Quelltext ist erhalten
    3544/5135 :                         ; geblieben, so läßt er sich mit "Y" reaktivieren.
    3545/5135 :                         
    3546/5135 : CD 29 51                QUIT:		call	sv_restore	; orig.	Sprungverteiler	wiederherstellen
    3547/5138 : 2A 00 FE                		ld	hl, (BUFBEG)	; Anfangsdresse
    3548/513B : 22 5B 18                		ld	(ARG1),	hl
    3549/513E : 22 5F 18                		ld	(ARG3),	hl
    3550/5141 : CD 79 44                		call	sub_4466	; Bufferende
    3551/5144 : 22 5D 18                		ld	(ARG2),	hl	; merken
    3552/5147 : C3 FD 07                		jp	GETCO1
